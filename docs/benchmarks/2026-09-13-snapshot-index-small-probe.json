  "probe_source": "import json,os,re,statistics,subprocess\nfrom pathlib import Path\nout=Path('probe-results').resolve();out.mkdir()\nenv=dict(os.environ,GOMAXPROCS='2',CGO_ENABLED='0')\nroots={'baseline':Path('baseline').resolve(),'candidate':Path.cwd()}\nbinaries={}\nfor name,root in roots.items():\n binary=out/(name+'.test')\n subprocess.run(['go','test','-c','-o',str(binary),'./experiments/snapshotindex'],cwd=root,env=env,check=True)\n binaries[name]=binary\nrows=[]\nfor repeat in range(7):\n for name in (['baseline','candidate'] if repeat%2==0 else ['candidate','baseline']):\n  result=subprocess.run([str(binaries[name]),'-test.run=^$','-test.bench=^BenchmarkIndex$/^(1000|10000)$/^(flat|tree)$/^(edit100|edit1_export)$','-test.benchtime=500ms','-test.count=1','-test.benchmem'],env=env,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,check=True)\n  (out/f'{repeat}-{name}.txt').write_text(result.stdout)\n  matches=re.findall(r'^BenchmarkIndex/(\\d+)/(\\w+)/(\\w+)-\\d+\\s+\\d+\\s+([\\d.]+) ns/op',result.stdout,re.M)\n  assert len(matches)==8\n  rows.extend(dict(round=repeat,variant=name,entries=int(count),representation=rep,operation=op,ns_per_op=float(ns)) for count,rep,op,ns in matches)\n print('Completed focused round',repeat+1,flush=True)\nsummary=[]\nfor count in [1000,10000]:\n for rep in ['flat','tree']:\n  for op in ['edit100','edit1_export']:\n   samples={name:[r['ns_per_op'] for r in rows if r['entries']==count and r['representation']==rep and r['operation']==op and r['variant']==name] for name in roots}\n   ratios=[b/a for a,b in zip(samples['baseline'],samples['candidate'])]\n   summary.append(dict(entries=count,representation=rep,operation=op,baseline_ms=statistics.median(samples['baseline'])/1e6,candidate_ms=statistics.median(samples['candidate'])/1e6,paired_median_ratio=statistics.median(ratios)))\nreport=dict(samples=rows,summary=summary,regression_threshold=1.15)\n(out/'report.json').write_text(json.dumps(report,indent=2)+'\\n')\nfor binary in binaries.values():binary.unlink()\nprint(json.dumps(summary,indent=2),flush=True)\nassert all(r['paired_median_ratio']<=1.15 for r in summary if r['representation']=='tree'),'REPRODUCED: isolated candidate tree slowdown exceeds 15%'\n"
